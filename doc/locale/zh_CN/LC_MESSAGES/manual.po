#~ msgstr "`Show` 输出方向与表达式，例如 `max  3.5x1 + 1.5x2 + -2x3`。"

#~ msgid "The empty set."
#~ msgstr "空集合。"

#~ msgid "Appends `poly = b`."
#~ msgstr "追加 `poly = b`。"

